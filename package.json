{
  "name": "english-learning-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint . --ext .ts,.vue",
    "type-check": "vue-tsc --noEmit",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "audio:dry-run": "python3 scripts/generate_audio.py --mode all --dry-run",
    "audio:generate": "python3 scripts/generate_audio.py --mode all"
  },
  "dependencies": {
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "less": "^4.9.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  }
}
